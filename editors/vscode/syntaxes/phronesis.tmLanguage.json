{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Phronesis",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#metadata"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.phronesis",
          "match": "#.*$"
        },
        {
          "name": "comment.block.phronesis",
          "begin": "##",
          "end": "##"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.phronesis",
          "match": "\\b(POLICY|CONST|IMPORT|IF|THEN|ELSE|AND|OR|NOT|IN)\\b"
        },
        {
          "name": "keyword.action.phronesis",
          "match": "\\b(ACCEPT|REJECT|REPORT|EXECUTE|BLOCK)\\b"
        },
        {
          "name": "keyword.other.phronesis",
          "match": "\\b(PRIORITY|EXPIRES|CREATED_BY|AS)\\b"
        },
        {
          "name": "keyword.test.phronesis",
          "match": "\\b(TEST|SCENARIO|GIVEN|EXPECT|DESCRIBE|IT)\\b"
        },
        {
          "name": "keyword.type.phronesis",
          "match": "\\b(TYPE|Integer|String|Boolean|Float|List|Map|Route)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.phronesis",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.phronesis",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.phronesis",
              "match": "\\$\\{[^}]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.phronesis",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.phronesis",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.phronesis",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.phronesis",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.numeric.hex.phronesis",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.phronesis",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.phronesis",
          "match": "\\b(nil|null)\\b"
        },
        {
          "name": "constant.language.time.phronesis",
          "match": "\\b(never|always)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.phronesis",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.arithmetic.phronesis",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.phronesis",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.phronesis",
          "match": "="
        },
        {
          "name": "keyword.operator.accessor.phronesis",
          "match": "(\\.|\\?\\.)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.stdlib.phronesis",
          "match": "\\b(Std\\.(RPKI|BGP|Consensus|Temporal)\\.[a-zA-Z_][a-zA-Z0-9_]*)\\b"
        },
        {
          "name": "entity.name.function.phronesis",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "metadata": {
      "patterns": [
        {
          "name": "meta.policy.phronesis",
          "match": "\\b(PRIORITY|EXPIRES|CREATED_BY)\\s*:\\s*([^\\s]+)",
          "captures": {
            "1": {
              "name": "keyword.other.phronesis"
            },
            "2": {
              "name": "constant.other.phronesis"
            }
          }
        }
      ]
    }
  },
  "scopeName": "source.phronesis"
}
