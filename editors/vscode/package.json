{
  "name": "phronesis",
  "displayName": "Phronesis Policy Language",
  "description": "Language support for Phronesis policy language with LSP integration",
  "version": "0.2.0",
  "publisher": "hyperpolymath",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperpolymath/phronesis"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "phronesis",
    "policy",
    "network",
    "consensus",
    "bgp",
    "rpki"
  ],
  "activationEvents": [
    "onLanguage:phronesis"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "phronesis",
        "aliases": [
          "Phronesis",
          "phronesis"
        ],
        "extensions": [
          ".phr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "phronesis",
        "scopeName": "source.phronesis",
        "path": "./syntaxes/phronesis.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Phronesis",
      "properties": {
        "phronesis.serverPath": {
          "type": "string",
          "default": "phronesis",
          "description": "Path to phronesis executable"
        },
        "phronesis.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.0.0"
  }
}
