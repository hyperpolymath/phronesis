# SPDX-License-Identifier: MPL-2.0
# Sample Phronesis policy for LSP testing

IMPORT Std.BGP
IMPORT Std.RPKI

CONST MIN_RISK_SCORE = 60
CONST MAX_AS_PATH_LENGTH = 10

POLICY validate_bgp_route:
  risk_score > MIN_RISK_SCORE
  THEN REJECT("Route failed validation")
  PRIORITY: 100
  EXPIRES: never
  CREATED_BY: network_admin

POLICY check_as_path:
  as_path_length > MAX_AS_PATH_LENGTH
  THEN REJECT("AS path too long")
  PRIORITY: 90
  EXPIRES: never
  CREATED_BY: network_admin
