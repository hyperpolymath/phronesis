# Example policy for debugging demonstration

IMPORT Std.BGP
IMPORT Std.RPKI
IMPORT Std.Consensus

CONST MAX_PATH_LENGTH = 10
CONST MIN_APPROVALS = 0.66
CONST VALID_ORIGINS = [64496, 64497, 64498]

# Simple route validation policy
POLICY validate_basic:
  IF route.valid == true THEN
    ACCEPT "Route is valid"
  ELSE
    REJECT "Route is invalid"
PRIORITY 50

# BGP path length check
POLICY check_path_length:
  path_len = Std.BGP.path_length(route)

  IF path_len < MAX_PATH_LENGTH THEN
    ACCEPT "Path length acceptable"
  ELSE
    REJECT "Path too long"
PRIORITY 100

# RPKI validation with consensus
POLICY validate_with_consensus:
  # Check RPKI first
  rpki_status = Std.RPKI.validate(route)

  # Get consensus votes
  votes = [
    {:approve, "validator-1"},
    {:approve, "validator-2"},
    {:reject, "validator-3"}
  ]

  consensus_result = Std.Consensus.vote("validate_route", votes, MIN_APPROVALS)

  # Require both RPKI and consensus
  IF rpki_status == :valid AND consensus_result == :approved THEN
    ACCEPT "Validated by RPKI and consensus"
  ELSE
    IF rpki_status != :valid THEN
      REJECT "RPKI validation failed"
    ELSE
      REJECT "Consensus not reached"
PRIORITY 200

# Origin AS validation
POLICY check_origin:
  origin = Std.BGP.get_origin(route)

  IF origin IN VALID_ORIGINS THEN
    ACCEPT "Origin AS is authorized"
  ELSE
    REJECT "Unknown origin AS"
PRIORITY 150
